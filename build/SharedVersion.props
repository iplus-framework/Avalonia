<Project DefaultTargets="Build" 
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Product>Avalonia</Product>
    <Version>12.2.999</Version>
    <!-- iPlus fork: all published NuGet packages are prefixed with "iPlus." (e.g. iPlus.Avalonia).
         Assembly names stay unchanged so project references and internal deps keep working;
         only the NuGet package identity changes. Set to '' to restore original package ids. -->
    <IPlusPackageIdPrefix Condition="'$(IPlusPackageIdPrefix)' == ''">iPlus.</IPlusPackageIdPrefix>
    <Authors>iPlus</Authors>
    <Copyright>Copyright 2013-$([System.DateTime]::Now.ToString(`yyyy`)) &#169; The AvaloniaUI Project; iPlus fork modifications</Copyright>
    <PackageProjectUrl>https://github.com/iplus-framework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iplus-framework/Avalonia/</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU5104</NoWarn>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageDescription>Avalonia is a cross-platform UI framework for .NET providing a flexible styling system and supporting a wide range of Operating Systems such as Windows, Linux, macOS and with experimental support for Android, iOS and WebAssembly.</PackageDescription>
    <PackageDescription Condition="'$(IPlusPackageIdPrefix)' != ''">iPlus fork of Avalonia - a cross-platform UI framework for .NET providing a flexible styling system and supporting a wide range of Operating Systems such as Windows, Linux, macOS and with experimental support for Android, iOS and WebAssembly. Based on AvaloniaUI/Avalonia with iPlus-specific modifications.</PackageDescription>
    <PackageTags>avalonia;avaloniaui;mvvm;rx;reactive extensions;android;ios;mac;forms;wpf;net;netstandard;net461;uwp;xamarin</PackageTags>
    <PackageReleaseNotes>https://github.com/iplus-framework/Avalonia/releases</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)\avalonia.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>

  <ItemGroup Label="PackageIcon">
    <None Include="$(MSBuildThisFileDirectory)/Assets/icon.png" Pack="true" Visible="false" PackagePath=""/>
  </ItemGroup>

  <!-- iPlus fork: rename NuGet package ids (not assembly names) for all packable projects.
       Runs as a target (not a property group) because SharedVersion.props is often imported
       before MSBuild has assigned AssemblyName. Projects that set their own PackageId
       (e.g. the DataGrid fork) already start with the prefix and are left untouched. -->
  <Target Name="IPlusSetPackageIdPrefix"
          BeforeTargets="_GenerateRestoreGraphProjectEntry;GenerateNuspec">
    <PropertyGroup Condition="'$(IPlusPackageIdPrefix)' != ''">
      <PackageId Condition="'$(PackageId)' == '' and '$(AssemblyName)' != ''">$(AssemblyName)</PackageId>
      <PackageId Condition="'$(PackageId)' != '' and !$(PackageId.StartsWith('$(IPlusPackageIdPrefix)'))">$(IPlusPackageIdPrefix)$(PackageId)</PackageId>
      <Title Condition="'$(Title)' == ''">$(PackageId)</Title>
    </PropertyGroup>
  </Target>
</Project>
